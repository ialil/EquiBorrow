<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		x:Class="EquiBorrow.UI.MainWindow"
		Title="EquiBorrow - UI" Width="1100" Height="780" MinWidth="900">

  <Window.Styles>
	<!-- Section container: one subtle panel per area -->
	<Style Selector="Border.card">
	  <Setter Property="Background" Value="#14808080"/>
	  <Setter Property="BorderBrush" Value="#33808080"/>
	  <Setter Property="BorderThickness" Value="1"/>
	  <Setter Property="CornerRadius" Value="6"/>
	  <Setter Property="Padding" Value="14"/>
	</Style>

	<!-- Text roles -->
	<Style Selector="TextBlock.title">
	  <Setter Property="FontSize" Value="22"/>
	  <Setter Property="FontWeight" Value="SemiBold"/>
	</Style>
	<Style Selector="TextBlock.section">
	  <Setter Property="FontSize" Value="15"/>
	  <Setter Property="FontWeight" Value="SemiBold"/>
	</Style>
	<Style Selector="TextBlock.muted">
	  <Setter Property="FontSize" Value="12"/>
	  <Setter Property="Opacity" Value="0.65"/>
	</Style>

	<!-- Buttons: same padding everywhere -->
	<Style Selector="Button">
	  <Setter Property="Padding" Value="14,6"/>
	</Style>
	<Style Selector="Button.wide">
	  <Setter Property="HorizontalAlignment" Value="Stretch"/>
	  <Setter Property="HorizontalContentAlignment" Value="Center"/>
	</Style>

	<!-- Lists: calmer selection instead of the bright system accent -->
	<Style Selector="ListBox">
	  <Setter Property="Background" Value="Transparent"/>
	  <Setter Property="BorderBrush" Value="#33808080"/>
	  <Setter Property="BorderThickness" Value="1"/>
	  <Setter Property="CornerRadius" Value="4"/>
	</Style>
	<Style Selector="ListBoxItem">
	  <Setter Property="Padding" Value="10,6"/>
	</Style>
	<Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
	  <Setter Property="Background" Value="#22808080"/>
	</Style>
	<Style Selector="ListBoxItem:selected /template/ ContentPresenter">
	  <Setter Property="Background" Value="#55808080"/>
	</Style>
	<Style Selector="ListBoxItem:selected:focus /template/ ContentPresenter">
	  <Setter Property="Background" Value="#55808080"/>
	</Style>
	<Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
	  <Setter Property="Background" Value="#66808080"/>
	</Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="20">

	<!-- HEADER -->
	<StackPanel Grid.Row="0" Margin="0,0,0,16" Spacing="2">
	  <TextBlock Classes="title" Text="EquiBorrow"/>
	  <TextBlock Classes="muted" Text="Campus Equipment Borrowing System"/>
	</StackPanel>

	<!-- MAIN CONTENT -->
	<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
	  <Grid ColumnDefinitions="*,240,*" Margin="0,0,12,0">

		<!-- LEFT: STUDENTS -->
		<StackPanel Grid.Column="0" Spacing="12">

		  <Border Classes="card">
			<StackPanel Spacing="8">
			  <TextBlock Classes="section" Text="Students"/>
			  <ListBox Name="StudentsList" ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent, Mode=TwoWay}" Height="200">
				<ListBox.ItemTemplate>
				  <DataTemplate>
					<StackPanel>
					  <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
					  <TextBlock Classes="muted" Text="{Binding StudentNumber}"/>
					  <TextBlock Classes="muted" Text="{Binding EligibilityStatus}"/>
					</StackPanel>
				  </DataTemplate>
				</ListBox.ItemTemplate>
			  </ListBox>
			  <Button Content="Student history" IsEnabled="{Binding CanOpenStudentHistory}" Click="StudentHistory_Click" HorizontalAlignment="Left"/>

			  <Expander Header="Add student" Margin="0,4,0,0">
				<StackPanel Spacing="8" Margin="0,8,0,0">
				  <TextBox Watermark="Student number" Text="{Binding NewStudentNumber, Mode=TwoWay}"/>
				  <TextBox Watermark="Full name" Text="{Binding NewStudentName, Mode=TwoWay}"/>
				  <TextBox Watermark="Contact (optional)" Text="{Binding NewStudentContact, Mode=TwoWay}"/>
				  <Button Content="Add student" Command="{Binding AddStudentCommand}" HorizontalAlignment="Left"/>
				</StackPanel>
			  </Expander>

			  <Expander Header="Edit selected student">
				<StackPanel Spacing="8" Margin="0,8,0,0">
				  <TextBox Watermark="Student number" Text="{Binding EditStudentNumber, Mode=TwoWay}"/>
				  <TextBox Watermark="Full name" Text="{Binding EditStudentName, Mode=TwoWay}"/>
				  <TextBox Watermark="Contact (optional)" Text="{Binding EditStudentContact, Mode=TwoWay}"/>
				  <Button Content="Update" Command="{Binding UpdateStudentCommand}" HorizontalAlignment="Left"/>
				</StackPanel>
			  </Expander>

			  <Expander Header="Borrowing eligibility">
				<StackPanel Spacing="8" Margin="0,8,0,0">
				  <TextBlock Text="{Binding SelectedStudentEligibility}"/>
				  <StackPanel Orientation="Horizontal" Spacing="8">
					<Button Content="Permit borrowing" Command="{Binding PermitBorrowingCommand}"/>
					<Button Content="Restrict borrowing" Command="{Binding RestrictBorrowingCommand}"/>
				  </StackPanel>
				</StackPanel>
			  </Expander>
			</StackPanel>
		  </Border>

		  <Border Classes="card">
			<StackPanel Spacing="8">
			  <TextBlock Classes="section" Text="Active borrowings"/>
			  <ListBox ItemsSource="{Binding ActiveBorrowings}" SelectedItem="{Binding SelectedActiveBorrowing, Mode=TwoWay}" Height="180" ScrollViewer.VerticalScrollBarVisibility="Auto">
				<ListBox.ItemTemplate>
				  <DataTemplate>
					<TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap"/>
				  </DataTemplate>
				</ListBox.ItemTemplate>
			  </ListBox>
			  <TextBlock Text="{Binding ActiveBorrowingsMessage}" IsVisible="{Binding ShowActiveBorrowingsMessage}" TextWrapping="Wrap"/>
			  <Button Content="Retry" Command="{Binding RetryActiveBorrowingsCommand}" IsVisible="{Binding HasActiveBorrowingsError}" HorizontalAlignment="Left"/>
			  <Button Content="Return selected" Command="{Binding ReturnSelectedCommand}" HorizontalAlignment="Left"/>
			  <StackPanel IsVisible="{Binding IsReturnConfirmationVisible}" Spacing="6">
				<TextBlock Text="{Binding ReturnConfirmationText}" TextWrapping="Wrap"/>
				<StackPanel Orientation="Horizontal" Spacing="8">
				  <Button Content="Confirm return" Command="{Binding ConfirmReturnCommand}"/>
				  <Button Content="Cancel" Command="{Binding CancelReturnCommand}"/>
				</StackPanel>
			  </StackPanel>
			</StackPanel>
		  </Border>
		</StackPanel>

		<!-- CENTER: ACTIONS -->
		<Border Grid.Column="1" Classes="card" Margin="12,0" VerticalAlignment="Top">
		  <StackPanel Spacing="8">
			<TextBlock Classes="section" Text="Actions"/>
			<TextBlock Classes="muted" Text="Expected return date" Margin="0,4,0,0"/>
			<CalendarDatePicker SelectedDate="{Binding ExpectedReturnDate, Mode=TwoWay}"
				DisplayDateStart="{Binding EarliestExpectedReturnDate}"
				HorizontalAlignment="Stretch"/>
			<Button Classes="wide accent" Content="Borrow" Command="{Binding BorrowCommand}"/>
			<Button Classes="wide" Content="Refresh" Command="{Binding RefreshCommand}"/>
			<Button Classes="wide" Content="Multi-item checkout" IsEnabled="{Binding CanOpenMultiItemCheckout}" Click="MultiItemCheckout_Click"/>
			<Button Classes="wide" Content="Search borrowings" IsEnabled="{Binding CanOpenBorrowingSearch}" Click="SearchBorrowings_Click"/>
			<TextBlock Classes="muted" Text="{Binding StatusMessage}" Margin="0,6,0,0" TextWrapping="Wrap"/>
		  </StackPanel>
		</Border>

		<!-- RIGHT: EQUIPMENT -->
		<Border Grid.Column="2" Classes="card" VerticalAlignment="Top">
		  <StackPanel Spacing="8">
			<TextBlock Classes="section" Text="Equipment"/>
			<CheckBox Content="Show available only" IsChecked="{Binding ShowAvailableOnly, Mode=TwoWay}" IsEnabled="{Binding CanChangeEquipmentFilter}"/>
			<ListBox Name="EquipmentsList" ItemsSource="{Binding Equipments}" SelectedItem="{Binding SelectedEquipment, Mode=TwoWay}" Height="200">
			  <ListBox.ItemTemplate>
				<DataTemplate>
				  <StackPanel>
					<TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
					<TextBlock Classes="muted" Text="{Binding Identifier}"/>
					<TextBlock Classes="muted" Text="{Binding DescriptionText}" IsVisible="{Binding HasDescription}" TextWrapping="Wrap"/>
					<TextBlock Classes="muted" Text="{Binding IsAvailable, StringFormat='Available: {0}'}"/>
				  </StackPanel>
				</DataTemplate>
			  </ListBox.ItemTemplate>
			</ListBox>
			<TextBlock Text="{Binding EquipmentMessage}" IsVisible="{Binding ShowEquipmentMessage}" TextWrapping="Wrap"/>
			<Button Content="Retry" Command="{Binding RetryEquipmentCommand}" IsVisible="{Binding HasEquipmentError}" HorizontalAlignment="Left"/>
			<Button Content="Equipment history" IsEnabled="{Binding CanOpenEquipmentHistory}" Click="EquipmentHistory_Click" HorizontalAlignment="Left"/>

			<Expander Header="Add equipment" Margin="0,4,0,0">
			  <StackPanel Spacing="8" Margin="0,8,0,0">
				<TextBox Watermark="Equipment identifier" Text="{Binding NewEquipmentIdentifier, Mode=TwoWay}"/>
				<TextBox Watermark="Name" Text="{Binding NewEquipmentName, Mode=TwoWay}"/>
				<TextBox Watermark="Description (optional)" Text="{Binding NewEquipmentDescription, Mode=TwoWay}"/>
				<Button Content="Add equipment" Command="{Binding AddEquipmentCommand}" HorizontalAlignment="Left"/>
			  </StackPanel>
			</Expander>

			<Expander Header="Edit selected equipment">
			  <StackPanel Spacing="8" Margin="0,8,0,0">
				<TextBox Watermark="Identifier" Text="{Binding EditEquipmentIdentifier, Mode=TwoWay}"/>
				<TextBox Watermark="Name" Text="{Binding EditEquipmentName, Mode=TwoWay}"/>
				<TextBox Watermark="Description (optional)" Text="{Binding EditEquipmentDescription, Mode=TwoWay}"/>
				<Button Content="Update" Command="{Binding UpdateEquipmentCommand}" HorizontalAlignment="Left"/>
			  </StackPanel>
			</Expander>
		  </StackPanel>
		</Border>

	  </Grid>
	</ScrollViewer>

	<!-- FOOTER -->
	<Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
	  <TextBlock Grid.Column="0" Text="Working..." FontStyle="Italic" Opacity="0.65" VerticalAlignment="Center" IsVisible="{Binding IsBusy}"/>
	  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
		<Button Content="Inspect SQL" Command="{Binding InspectSqlCommand}" MinWidth="110"/>
		<Button Content="Close" Click="Close_Click" MinWidth="90"/>
	  </StackPanel>
	</Grid>

  </Grid>
</Window>