<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		x:Class="EquiBorrow.UI.MainWindow"
		Title="EquiBorrow - UI" Width="900" Height="760">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="20">
	<TextBlock Text="EquiBorrow - Campus Equipment Borrowing System" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,16"/>

	<Grid Grid.Row="1" Margin="0,0">
	  <Grid.ColumnDefinitions>
		<ColumnDefinition Width="*" />
		<ColumnDefinition Width="*" />
		<ColumnDefinition Width="*" />
	  </Grid.ColumnDefinitions>

	  <!-- STUDENTS SECTION -->
	  <StackPanel Grid.Column="0" Margin="0,0,16,0">
		<TextBlock Text="Students" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
		<ListBox Name="StudentsList" ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent, Mode=TwoWay}" Height="200">
		  <ListBox.ItemTemplate>
			<DataTemplate>
			  <StackPanel Margin="4,2">
				<TextBlock Text="{Binding StudentNumber}" />
				<TextBlock Text="{Binding Name}" />
				<TextBlock Text="{Binding EligibilityStatus}" FontSize="10" />
			  </StackPanel>
			</DataTemplate>
		  </ListBox.ItemTemplate>
		</ListBox>
		<Button Content="Student history" IsEnabled="{Binding CanOpenStudentHistory}" Click="StudentHistory_Click" MinWidth="120" HorizontalAlignment="Left" Margin="0,6,0,0" />

		<TextBlock Text="Active Borrowings" FontWeight="Bold" FontSize="12" Margin="0,12,0,8"/>
		<ListBox ItemsSource="{Binding ActiveBorrowings}" SelectedItem="{Binding SelectedActiveBorrowing, Mode=TwoWay}" Height="180" ScrollViewer.VerticalScrollBarVisibility="Auto">
		  <ListBox.ItemTemplate>
			<DataTemplate>
			  <TextBlock Text="{Binding DisplayText}" Margin="4,2" TextWrapping="Wrap"/>
			</DataTemplate>
		  </ListBox.ItemTemplate>
		</ListBox>
		<TextBlock Text="{Binding ActiveBorrowingsMessage}" IsVisible="{Binding ShowActiveBorrowingsMessage}" TextWrapping="Wrap" Margin="4,4"/>
		<Button Content="Retry" Command="{Binding RetryActiveBorrowingsCommand}" IsVisible="{Binding HasActiveBorrowingsError}" MinWidth="70" HorizontalAlignment="Left"/>
		<Button Content="Return selected" Command="{Binding ReturnSelectedCommand}" MinWidth="120" HorizontalAlignment="Left"/>
		<StackPanel IsVisible="{Binding IsReturnConfirmationVisible}" Margin="0,8,0,0" Spacing="6">
		  <TextBlock Text="{Binding ReturnConfirmationText}" TextWrapping="Wrap"/>
		  <StackPanel Orientation="Horizontal" Spacing="8">
			<Button Content="Confirm return" Command="{Binding ConfirmReturnCommand}" MinWidth="110"/>
			<Button Content="Cancel" Command="{Binding CancelReturnCommand}" MinWidth="70"/>
		  </StackPanel>
		</StackPanel>

		<StackPanel Margin="0,12,0,0" Spacing="8">
		  <TextBox Watermark="Student number" Text="{Binding NewStudentNumber, Mode=TwoWay}" />
		  <TextBox Watermark="Full name" Text="{Binding NewStudentName, Mode=TwoWay}" />
		  <TextBox Watermark="Contact (optional)" Text="{Binding NewStudentContact, Mode=TwoWay}" />
		  <Button Content="Add Student" Command="{Binding AddStudentCommand}" MinWidth="100" HorizontalAlignment="Left" />
		</StackPanel>

		<StackPanel Margin="0,16,0,0" Spacing="8">
		  <TextBlock Text="Edit selected student" FontWeight="Bold" />
		  <TextBox Watermark="Student number" Text="{Binding EditStudentNumber, Mode=TwoWay}" />
		  <TextBox Watermark="Full name" Text="{Binding EditStudentName, Mode=TwoWay}" />
		  <TextBox Watermark="Contact (optional)" Text="{Binding EditStudentContact, Mode=TwoWay}" />
		  <Button Content="Update" Command="{Binding UpdateStudentCommand}" MinWidth="80" HorizontalAlignment="Left" />
		</StackPanel>

		<StackPanel Margin="0,16,0,0" Spacing="8">
		  <TextBlock Text="Borrowing eligibility" FontWeight="Bold" />
		  <TextBlock Text="{Binding SelectedStudentEligibility}" />
		  <Button Content="Permit borrowing" Command="{Binding PermitBorrowingCommand}" MinWidth="120" HorizontalAlignment="Left" />
		  <Button Content="Restrict borrowing" Command="{Binding RestrictBorrowingCommand}" MinWidth="120" HorizontalAlignment="Left" />
		</StackPanel>
	  </StackPanel>

	  <!-- CENTER BUTTONS -->
	  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0" Spacing="8">
		<TextBlock Text="Expected return date" HorizontalAlignment="Center"/>
		<CalendarDatePicker SelectedDate="{Binding ExpectedReturnDate, Mode=TwoWay}"
			DisplayDateStart="{Binding EarliestExpectedReturnDate}"
			HorizontalAlignment="Center"/>
		<Button Content="Borrow →" Command="{Binding BorrowCommand}" MinWidth="120" HorizontalAlignment="Center"/>
		<Button Content="Refresh" Command="{Binding RefreshCommand}" MinWidth="120" HorizontalAlignment="Center"/>
		<TextBlock Text="{Binding StatusMessage}" FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="260"/>
	  </StackPanel>

	  <!-- EQUIPMENT SECTION -->
	  <StackPanel Grid.Column="2" Margin="16,0,0,0">
		<TextBlock Text="Equipment" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
		<ListBox Name="EquipmentsList" ItemsSource="{Binding Equipments}" SelectedItem="{Binding SelectedEquipment, Mode=TwoWay}" Height="200">
		  <ListBox.ItemTemplate>
			<DataTemplate>
			  <StackPanel>
				<TextBlock Text="{Binding Identifier}" Margin="4"/>
				<TextBlock Text="{Binding Name}" Margin="4,0"/>
				<TextBlock Text="{Binding IsAvailable, StringFormat='Available: {0}'}" FontSize="10" Margin="4,0,4,2"/>
			  </StackPanel>
			</DataTemplate>
		  </ListBox.ItemTemplate>
		</ListBox>
		<Button Content="Equipment history" IsEnabled="{Binding CanOpenEquipmentHistory}" Click="EquipmentHistory_Click" MinWidth="130" HorizontalAlignment="Left" Margin="0,6,0,0" />

		<StackPanel Margin="0,12,0,0" Spacing="8">
		  <TextBox Watermark="Equipment identifier" Text="{Binding NewEquipmentIdentifier, Mode=TwoWay}" />
		  <TextBox Watermark="Name" Text="{Binding NewEquipmentName, Mode=TwoWay}" />
		  <TextBox Watermark="Description (optional)" Text="{Binding NewEquipmentDescription, Mode=TwoWay}" />
		  <Button Content="Add Equipment" Command="{Binding AddEquipmentCommand}" MinWidth="100" HorizontalAlignment="Left" />
		</StackPanel>

		<StackPanel Margin="0,16,0,0" Spacing="8">
		  <TextBlock Text="Edit selected equipment" FontWeight="Bold" />
		  <TextBox Watermark="Identifier" Text="{Binding EditEquipmentIdentifier, Mode=TwoWay}" />
		  <TextBox Watermark="Name" Text="{Binding EditEquipmentName, Mode=TwoWay}" />
		  <TextBox Watermark="Description (optional)" Text="{Binding EditEquipmentDescription, Mode=TwoWay}" />
		  <Button Content="Update" Command="{Binding UpdateEquipmentCommand}" MinWidth="80" HorizontalAlignment="Left" />
		</StackPanel>
	  </StackPanel>
	</Grid>

  <!-- moved StatusMessage into center column; keep Working indicator below so it's visible near controls -->
  <StackPanel Grid.Row="2" Margin="0,16,0,0" HorizontalAlignment="Center">
	<TextBlock Text="Working..." FontStyle="Italic" Foreground="Gray" IsVisible="{Binding IsBusy}" Margin="0,4" />
  </StackPanel>

	<StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
	  <Button Content="Inspect SQL" Command="{Binding InspectSqlCommand}" Width="120" />
	  <Button Content="Close" Width="100" Click="Close_Click"/>
	</StackPanel>
  </Grid>
  </ScrollViewer>
</Window>
