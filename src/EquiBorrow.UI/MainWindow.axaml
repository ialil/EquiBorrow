<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		x:Class="EquiBorrow.UI.MainWindow"
		Title="EquiBorrow - UI" Width="900" Height="500">
  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="20">
	<TextBlock Text="EquiBorrow - Campus Equipment Borrowing System" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,16"/>

	<Grid Grid.Row="1" Margin="0,0">
	  <Grid.ColumnDefinitions>
		<ColumnDefinition Width="*" />
		<ColumnDefinition Width="*" />
		<ColumnDefinition Width="*" />
	  </Grid.ColumnDefinitions>

	  <!-- STUDENTS SECTION -->
	  <StackPanel Grid.Column="0" Margin="0,0,16,0">
		<TextBlock Text="Students" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
		<ListBox Name="StudentsList" ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent, Mode=TwoWay}" Height="200">
		  <ListBox.ItemTemplate>
			<DataTemplate>
			  <TextBlock Text="{Binding Name}" Margin="4"/>
			</DataTemplate>
		  </ListBox.ItemTemplate>
		</ListBox>

		<TextBlock Text="Borrowed Items (Memory)" FontWeight="Bold" FontSize="12" Margin="0,12,0,8"/>
		<ListBox ItemsSource="{Binding StudentBorrows}" Height="120">
		  <ListBox.ItemTemplate>
			<DataTemplate>
			  <StackPanel>
				<TextBlock Text="{Binding EquipmentName}" Margin="4,2"/>
				<TextBlock Text="{Binding BorrowDate, StringFormat='Borrowed on: {0:g}'}" FontSize="10" Margin="4,0,4,2"/>
			  </StackPanel>
			</DataTemplate>
		  </ListBox.ItemTemplate>
		</ListBox>

		<StackPanel Margin="0,12,0,0" Spacing="8">
		  <TextBox Watermark="Student name" Text="{Binding NewStudentName, Mode=TwoWay}" />
		  <CheckBox Content="Active" IsChecked="{Binding NewStudentIsActive, Mode=TwoWay}"/>
		  <StackPanel Orientation="Horizontal" Spacing="8">
			<Button Content="Add Student" Command="{Binding AddStudentCommand}" Width="100" />
			<Button Content="Update" Command="{Binding UpdateStudentCommand}" Width="80" />
			<Button Content="Remove" Command="{Binding RemoveStudentCommand}" Width="80" />
		  </StackPanel>
		</StackPanel>
	  </StackPanel>

	  <!-- CENTER BUTTONS -->
	  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0">
		<Button Content="Borrow →" Command="{Binding BorrowCommand}" Width="120" Margin="0,0,0,12" HorizontalAlignment="Center"/>
		<Button Content="Refresh" Command="{Binding RefreshCommand}" Width="120" HorizontalAlignment="Center"/>
	  </StackPanel>

	  <!-- EQUIPMENT SECTION -->
	  <StackPanel Grid.Column="2" Margin="16,0,0,0">
		<TextBlock Text="Equipment" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
		<ListBox Name="EquipmentsList" ItemsSource="{Binding Equipments}" SelectedItem="{Binding SelectedEquipment, Mode=TwoWay}" Height="200">
		  <ListBox.ItemTemplate>
			<DataTemplate>
			  <StackPanel>
				<TextBlock Text="{Binding Name}" Margin="4"/>
				<TextBlock Text="{Binding IsAvailable, StringFormat='Available: {0}'}" FontSize="10" Margin="4,0,4,2"/>
			  </StackPanel>
			</DataTemplate>
		  </ListBox.ItemTemplate>
		</ListBox>

		<StackPanel Margin="0,12,0,0" Spacing="8">
		  <TextBox Watermark="Equipment name" Text="{Binding NewEquipmentName, Mode=TwoWay}" />
		  <CheckBox Content="Available" IsChecked="{Binding NewEquipmentIsAvailable, Mode=TwoWay}"/>
		  <StackPanel Orientation="Horizontal" Spacing="8">
			<Button Content="Add Equipment" Command="{Binding AddEquipmentCommand}" Width="100" />
			<Button Content="Update" Command="{Binding UpdateEquipmentCommand}" Width="80" />
			<Button Content="Remove" Command="{Binding RemoveEquipmentCommand}" Width="80" />
		  </StackPanel>
		</StackPanel>
	  </StackPanel>
	</Grid>

	<StackPanel Grid.Row="2" Margin="0,16,0,0">
	  <TextBlock Text="{Binding StatusMessage}" FontSize="12" Margin="0,4"/>
	</StackPanel>

	<StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
	  <Button Content="Close" Width="100" Click="Close_Click"/>
	</StackPanel>
  </Grid>
</Window>
