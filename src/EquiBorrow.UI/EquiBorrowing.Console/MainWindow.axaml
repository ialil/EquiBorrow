<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		x:Class="EquiBorrow.UI.MainWindow"
		Title="EquiBorrow - UI" Width="700" Height="420"
		Background="#F2F2F2">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20">
	<TextBlock Text="EquiBorrow" FontSize="24" Foreground="Black" HorizontalAlignment="Center" Margin="0,8"/>

	<Grid Grid.Row="1" Margin="0,12">
	  <Grid.ColumnDefinitions>
		<ColumnDefinition Width="*" />
		<ColumnDefinition Width="Auto" />
		<ColumnDefinition Width="*" />
	  </Grid.ColumnDefinitions>

		<Border Grid.Column="0" Background="#EAEAEA" Padding="8" CornerRadius="6" Margin="0,0,8,0">
		<StackPanel>
		  <TextBlock Text="Students" FontWeight="Bold" Foreground="Black"/>
			<ListBox Name="StudentsList" SelectedItem="{Binding SelectedStudent, Mode=TwoWay}" Height="180" Background="#FFFFFF" BorderBrush="#D0D0D0">
			<ListBox.ItemTemplate>
			  <DataTemplate>
				<TextBlock Text="{Binding Name}" Foreground="Black" Margin="4"/>
			  </DataTemplate>
			</ListBox.ItemTemplate>
		  </ListBox>

		  <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Spacing="8">
			<TextBox Width="180" Watermark="Student name" Text="{Binding NewStudentName, Mode=TwoWay}" />
			<CheckBox Content="Active" IsChecked="{Binding NewStudentIsActive, Mode=TwoWay}" VerticalAlignment="Center"/>
		  </StackPanel>
			<StackPanel Orientation="Horizontal" Margin="0,8,0,0" Spacing="8">
			<Button Classes="primary" Content="Add Student" Command="{Binding AddStudentCommand}" Width="140" />
			<Button Classes="secondary" Content="Update" Command="{Binding UpdateStudentCommand}" Width="80" />
			<Button Classes="danger" Content="Remove" Command="{Binding RemoveStudentCommand}" Width="80" />
		  </StackPanel>
		</StackPanel>
	  </Border>

	  <StackPanel Grid.Column="1" VerticalAlignment="Center" Width="140" HorizontalAlignment="Center">
		<Button Classes="primary" Content="Borrow ?" Command="{Binding BorrowCommand}" Width="120" IsEnabled="{Binding CanBorrowEnabled}" ToolTip.Tip="{Binding BorrowButtonTooltip}"/>
		<Button Classes="secondary" Content="Refresh" Command="{Binding RefreshCommand}" Width="120" Margin="0,8,0,0"/>
	  </StackPanel>

		<Border Grid.Column="2" Background="#EAEAEA" Padding="8" CornerRadius="6" Margin="8,0,0,0">
		<StackPanel>
		  <TextBlock Text="Equipment" FontWeight="Bold" Foreground="Black"/>
			<ListBox Name="EquipmentsList" SelectedItem="{Binding SelectedEquipment, Mode=TwoWay}" Height="180" Background="#FFFFFF" BorderBrush="#D0D0D0">
			<ListBox.ItemTemplate>
			  <DataTemplate>
				<StackPanel Orientation="Horizontal">
				  <Ellipse Fill="{Binding AvailabilityBrush}" Width="12" Height="12" Margin="6" VerticalAlignment="Center"/>
				  <TextBlock Text="{Binding Name}" Foreground="Black" Margin="4"/>
				  <TextBlock Text=" (" Foreground="Black" />
				  <TextBlock Text="{Binding AvailabilityText}" Foreground="Black" />
				  <TextBlock Text=")" Foreground="Black" />
				</StackPanel>
			  </DataTemplate>
			</ListBox.ItemTemplate>
		  </ListBox>

		  <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Spacing="8">
			<TextBox Width="180" Watermark="Equipment name" Text="{Binding NewEquipmentName, Mode=TwoWay}" />
			<CheckBox Content="Available" IsChecked="{Binding NewEquipmentIsAvailable, Mode=TwoWay}" VerticalAlignment="Center"/>
		  </StackPanel>
		  <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Spacing="8">
			<Button Classes="primary" Content="Add Equipment" Command="{Binding AddEquipmentCommand}" Width="140" />
			<Button Classes="secondary" Content="Update" Command="{Binding UpdateEquipmentCommand}" Width="80" />
			<Button Classes="danger" Content="Remove" Command="{Binding RemoveEquipmentCommand}" Width="80" />
		  </StackPanel>
		</StackPanel>
	  </Border>
	</Grid>

	<StackPanel Grid.Row="2" Margin="0,18" HorizontalAlignment="Stretch">
	  <TextBlock Text="Welcome to the Campus Equipment Borrowing System" Foreground="Black" FontSize="14" Margin="0,4"/>
	  <TextBlock Text="{Binding StatusMessage}" Foreground="Black" Margin="0,6"/>
	</StackPanel>

	<StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
	  <Button Content="Close" Width="100" Click="Close_Click"/>
	</StackPanel>
  </Grid>
</Window>
