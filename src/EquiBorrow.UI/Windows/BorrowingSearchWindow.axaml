<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		x:Class="EquiBorrow.UI.Windows.BorrowingSearchWindow"
		Title="Search Borrowings" Width="900" Height="720">
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="20">
	<TextBlock Text="Search borrowings" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" />

	<Grid Grid.Row="1" ColumnDefinitions="2*,*,*,*,Auto" Margin="0,0,0,12">
	  <TextBox Grid.Column="0" Margin="0,0,6,0"
			   Watermark="Student number/name or equipment identifier/name"
			   Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
			   KeyDown="SearchText_KeyDown" />
	  <ComboBox Grid.Column="1" Margin="0,0,6,0" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus, Mode=TwoWay}" />
	  <ComboBox Grid.Column="2" Margin="0,0,6,0" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort, Mode=TwoWay}" />
	  <ComboBox Grid.Column="3" Margin="0,0,6,0" ItemsSource="{Binding DirectionOptions}" SelectedItem="{Binding SelectedDirection, Mode=TwoWay}" />
	  <Button Grid.Column="4" Content="Clear" Command="{Binding ClearCommand}" MinWidth="70" />
	</Grid>

	<ListBox Grid.Row="2" ItemsSource="{Binding Results}" IsVisible="{Binding ShowResults}">
	  <ListBox.ItemTemplate>
		<DataTemplate>
		  <Grid ColumnDefinitions="*,*,Auto" RowDefinitions="Auto,Auto,Auto" Margin="6,5">
			<TextBlock Grid.Column="0" Text="{Binding StudentNumber}" FontWeight="Bold" />
			<TextBlock Grid.Column="1" Text="{Binding EquipmentIdentifier}" FontWeight="Bold" />
			<TextBlock Grid.Column="2" Text="{Binding StatusText}" FontWeight="Bold" />
			<TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding StudentName}" TextWrapping="Wrap" />
			<TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EquipmentName}" TextWrapping="Wrap" />
			<TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding BorrowDate, StringFormat='Checkout: {0:yyyy-MM-dd}'}" />
			<TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ExpectedReturnDate, StringFormat='Due: {0:yyyy-MM-dd}'}" />
			<TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding ReturnDateText, StringFormat='Returned: {0}'}" IsVisible="{Binding HasReturnDate}" />
		  </Grid>
		</DataTemplate>
	  </ListBox.ItemTemplate>
	</ListBox>

	<TextBlock Grid.Row="2" Text="Loading borrowings..." IsVisible="{Binding IsLoading}" HorizontalAlignment="Center" VerticalAlignment="Center" />
	<TextBlock Grid.Row="2" Text="{Binding Message}" IsVisible="{Binding ShowEmptyState}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />

	<TextBlock Grid.Row="3" Text="{Binding Message}" IsVisible="{Binding HasError}" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,8" />
	<Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
	  <TextBlock Text="{Binding ResultCountText}" VerticalAlignment="Center" />
	  <Button Grid.Column="1" Content="Retry" Command="{Binding RetryCommand}" IsVisible="{Binding HasError}" MinWidth="80" />
	</Grid>
  </Grid>
</Window>
